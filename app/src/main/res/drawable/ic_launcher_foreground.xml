<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground, 108dp canvas. All artwork stays inside the centered
  66dp safe zone (x/y from 21 to 87) so it survives every adaptive-icon mask.

  Artwork: dark rounded hexagon outline + green lightning bolt (brand: neon green
  #00FF9D on near-black #070B14).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hexagon fill (pointy-top, radius 30 around center 54,54) -->
    <path
        android:fillColor="#0F1626"
        android:pathData="M54,24 L80,39 L80,69 L54,84 L28,69 L28,39 Z" />

    <!-- Hexagon rounded outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2E4A78"
        android:strokeWidth="3"
        android:strokeLineJoin="round"
        android:pathData="M54,24 L80,39 L80,69 L54,84 L28,69 L28,39 Z" />

    <!-- Lightning bolt (scaled/centered classic flash shape) -->
    <path
        android:fillColor="#00FF9D"
        android:pathData="M46,38 L46,55.6 L50.8,55.6 L50.8,70 L62,50.8 L55.6,50.8 L62,38 Z" />
</vector>
